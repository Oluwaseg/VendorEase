<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Your Order is Confirmed</title>
    <!--[if mso]>
    <noscript>
    <xml>
    <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
    </xml>
    </noscript>
    <![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap');
      @font-face {
        font-family: 'Clash Display';
        src: url('https://api.fontshare.com/v2/css?f[]=clash-display@700,600&display=swap');
      }

      body,
      p,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        margin: 0;
        padding: 0;
      }
      body {
        font-family:
          'Manrope',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background-color: #f9fafb;
        color: #12171a;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        width: 100% !important;
      }
      table {
        border-collapse: collapse !important;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        display: block;
      }

      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f9fafb;
        padding: 40px 0;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        border: 1px solid #e1e4e8;
      }

      .header {
        padding: 32px 40px;
        text-align: left;
        border-bottom: 1px solid #f3f4f6;
      }
      .logo {
        max-width: 32px;
        display: inline-block;
        vertical-align: middle;
      }
      .brand-name {
        display: inline-block;
        vertical-align: middle;
        margin-left: 12px;
        font-family: 'Clash Display', sans-serif;
        font-size: 18px;
        font-weight: 700;
        color: #12171a;
      }

      .hero {
        padding: 48px 40px;
        text-align: center;
        background-color: #ffffff;
        border-bottom: 1px solid #f3f4f6;
      }
      .success-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 24px;
        background-color: #ecfdf3;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #37b880;
        font-size: 32px;
        line-height: 64px;
      }
      .hero h1 {
        font-family: 'Clash Display', sans-serif;
        font-size: 28px;
        color: #12171a;
        margin-bottom: 12px;
        letter-spacing: -0.02em;
      }
      .hero p {
        color: #6b7280;
        font-size: 16px;
      }

      .content {
        padding: 40px;
      }
      .section-title {
        font-family: 'Clash Display', sans-serif;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #9ca3af;
        margin-bottom: 16px;
      }

      .order-meta {
        background-color: #f9fafb;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
        border: 1px solid #f3f4f6;
      }
      .meta-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .meta-row:last-child {
        margin-bottom: 0;
      }
      .meta-label {
        font-size: 13px;
        color: #6b7280;
      }
      .meta-value {
        font-size: 13px;
        font-weight: 700;
        color: #12171a;
      }
      .order-id {
        font-family: monospace;
        background: #12171a;
        color: #ffffff;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 12px;
      }

      .item-list {
        margin-bottom: 32px;
      }
      .item-row {
        padding: 16px 0;
        border-bottom: 1px solid #f3f4f6;
      }
      .item-row:last-child {
        border-bottom: none;
      }
      .item-info {
        font-weight: 600;
        color: #12171a;
        font-size: 14px;
      }
      .item-price {
        font-weight: 700;
        color: #12171a;
        font-size: 14px;
        text-align: right;
      }

      .shipping-card {
        background-color: #ffffff;
        border: 1px solid #f3f4f6;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 32px;
      }
      .shipping-text {
        font-size: 14px;
        color: #4b5563;
        line-height: 1.8;
      }

      .footer {
        padding: 40px;
        text-align: center;
        font-size: 13px;
        color: #9ca3af;
        border-top: 1px solid #f3f4f6;
      }

      @media screen and (max-width: 600px) {
        .container {
          border-radius: 0;
          border: none;
        }
        .content,
        .header,
        .footer {
          padding: 30px 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='container'>
        <div class='header'>
          <img
            src='https://res.cloudinary.com/djc5o8g94/image/upload/v1735699430/Sos/nsrtetcca9bfnfx7xx8x.png'
            alt='VendorEase'
            class='logo'
          />
          <div class='brand-name'>VendorEase</div>
        </div>

        <div class='hero'>
          <div class='success-icon'>✓</div>
          <h1>Order Confirmed</h1>
          <p>Hi
            {{name}}, thank you for your purchase! We've received your order and
            we're getting it ready for you.</p>
        </div>

        <div class='content'>
          <div class='section-title'>Order Summary</div>
          <div class='order-meta'>
            <table width='100%'>
              <tr>
                <td class='meta-label' style='padding-bottom: 12px;'>Order ID</td>
                <td
                  class='meta-value'
                  style='text-align: right; padding-bottom: 12px;'
                ><span class='order-id'>{{orderId}}</span></td>
              </tr>
              <tr>
                <td class='meta-label' style='padding-bottom: 12px;'>Payment
                  Status</td>
                <td
                  class='meta-value'
                  style='text-align: right; padding-bottom: 12px; color: #37b880;'
                >{{paymentStatus}}</td>
              </tr>
              <tr>
                <td class='meta-label' style='padding-bottom: 12px;'>Shipping
                  Status</td>
                <td
                  class='meta-value'
                  style='text-align: right; padding-bottom: 12px;'
                >{{shippingStatus}}</td>
              </tr>
              <tr style='border-top: 1px solid #e1e4e8;'>
                <td
                  class='meta-label'
                  style='padding-top: 12px; font-weight: 700; color: #12171a;'
                >Total Amount</td>
                <td
                  class='meta-value'
                  style='text-align: right; padding-top: 12px; font-size: 18px; color: #1f74bf;'
                >₦{{total}}</td>
              </tr>
            </table>
          </div>

          <div class='section-title'>Items Ordered</div>
          <div class='item-list'>
            <table width='100%'>
              {{#each items}}
                <tr class='item-row'>
                  <td
                    class='item-info'
                    style='padding: 12px 0; border-bottom: 1px solid #f3f4f6;'
                  >{{name}}
                    <span
                      style='color: #9ca3af; font-weight: 400; margin-left: 8px;'
                    >× {{quantity}}</span></td>
                  <td
                    class='item-price'
                    style='padding: 12px 0; border-bottom: 1px solid #f3f4f6; text-align: right;'
                  >₦{{price}}</td>
                </tr>
              {{/each}}
            </table>
          </div>

          <div class='section-title'>Shipping To</div>
          <div class='shipping-card'>
            <p class='shipping-text'>
              <strong>{{name}}</strong><br />
              {{shipping.addressLine}}<br />
              {{shipping.city}}{{#if shipping.state}},
                {{shipping.state}}{{/if}}<br />
              {{shipping.country}}
              {{shipping.postalCode}}<br />
              <span
                style='display: inline-block; margin-top: 8px; color: #1f74bf; font-weight: 600;'
              >Method: {{shipping.method}}</span>
            </p>
          </div>

          <p style='text-align: center; color: #6b7280; font-size: 14px;'>We'll
            send you another update as soon as your order is on its way!</p>
        </div>

        <div class='footer'>
          <p>&copy; {{currentYear}} VendorEase. All rights reserved.</p>
          <p>123 Commerce Way, Retail District, New York, NY 10001</p>
        </div>
      </div>
    </div>
  </body>
</html>