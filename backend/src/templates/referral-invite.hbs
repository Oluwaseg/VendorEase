<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>You're Invited to VendorEase</title>
    <!--[if mso]>
    <noscript>
    <xml>
    <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
    </xml>
    </noscript>
    <![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap');

      body,
      p,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        margin: 0;
        padding: 0;
      }
      .ExternalClass {
        width: 100%;
      }
      .ExternalClass,
      .ExternalClass p,
      .ExternalClass span,
      .ExternalClass font,
      .ExternalClass td,
      .ExternalClass div {
        line-height: 100%;
      }
      #outlook a {
        padding: 0;
      }
      table {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
        border-collapse: collapse !important;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        display: block;
      }

      body {
        font-family:
          'Manrope',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background-color: #f9fafb;
        color: #12171a;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        width: 100% !important;
      }

      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f9fafb;
        padding-bottom: 40px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        border: 1px solid #e1e4e8;
      }

      .header {
        padding: 30px 40px;
        text-align: left;
        border-bottom: 1px solid #f3f4f6;
      }
      .logo-container {
        display: inline-block;
        vertical-align: middle;
      }
      .logo {
        max-width: 32px;
        max-height: 32px;
        display: inline-block;
        vertical-align: middle;
      }
      .brand-name {
        display: inline-block;
        vertical-align: middle;
        font-size: 20px;
        font-weight: 800;
        color: #12171a;
        margin-left: 10px;
        letter-spacing: -0.02em;
      }

      .content {
        padding: 0 40px 40px;
        text-align: center;
      }

      .invitation-card {
        background: linear-gradient(135deg, #1f74bf, #12171a);
        border-radius: 24px;
        padding: 40px 30px;
        margin-bottom: 32px;
        color: #ffffff;
        text-align: center;
      }

      .badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        background-color: rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 20px;
      }

      h2 {
        font-size: 26px;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 16px;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }
      .invitation-text {
        font-size: 16px;
        color: rgba(255, 255, 255, 0.9);
        margin-bottom: 0;
      }

      .referral-info {
        background-color: #f9fafb;
        border-radius: 16px;
        padding: 24px;
        margin: 32px 0;
        border: 1px solid #e1e4e8;
      }

      .referral-label {
        font-size: 12px;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
      }
      .referral-code {
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-size: 20px;
        font-weight: 700;
        color: #1f74bf;
        letter-spacing: 0.1em;
      }

      .btn-container {
        margin: 32px 0;
      }
      .button {
        background-color: #1f74bf;
        background: linear-gradient(135deg, #1f74bf, #3a8cd9);
        color: #ffffff !important;
        text-decoration: none;
        padding: 18px 36px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 16px;
        display: inline-block;
        box-shadow: 0 10px 20px rgba(31, 116, 191, 0.15);
      }

      .link-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #f3f4f6;
        text-align: left;
      }
      .link-label {
        font-size: 12px;
        color: #9ca3af;
        margin-bottom: 8px;
        display: block;
      }
      .token-link {
        font-size: 13px;
        color: #1f74bf;
        word-break: break-all;
        text-decoration: none;
      }

      .footer {
        padding: 30px 40px;
        text-align: center;
        font-size: 13px;
        color: #9ca3af;
        border-top: 1px solid #f3f4f6;
      }

      @media screen and (max-width: 600px) {
        .container {
          width: 100% !important;
          border-radius: 0 !important;
          border: none !important;
        }
        .header,
        .content {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .invitation-card {
          padding: 30px 20px !important;
        }
        h2 {
          font-size: 22px !important;
        }
        .button {
          width: 100% !important;
          box-sizing: border-box;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <!--[if mso]>
        <table role="presentation" width="600" align="center" style="width:600px;">
        <tr>
        <td>
        <![endif]-->
      <table
        role='presentation'
        width='100%'
        cellspacing='0'
        cellpadding='0'
        style='max-width: 600px; margin: 0 auto;'
      >
        <tr>
          <td align='center' style='padding: 40px 0;'>
            <div class='container'>
              <div class='header'>
                <div class='logo-container'>
                  <img
                    src='https://res.cloudinary.com/djc5o8g94/image/upload/v1735699430/Sos/nsrtetcca9bfnfx7xx8x.png'
                    alt='Logo'
                    class='logo'
                  />
                  <span class='brand-name'>VendorEase</span>
                </div>
              </div>

              <div class='content' style='padding-top: 40px;'>
                <div class='invitation-card'>
                  <div class='badge'>Special Invitation</div>
                  <h2>{{fromName}} wants you to join VendorEase</h2>
                  <p class='invitation-text'>Your friend has invited you to
                    discover a better way to shop. Join our community today and
                    unlock exclusive benefits right from your first order.</p>
                </div>

                <p style='color: #4b5563;'>By joining through this invitation,
                  you'll help
                  <strong>{{fromName}}</strong>
                  unlock special rewards while you get access to our premium
                  collection of products.</p>

                <div class='btn-container'>
                  <!--[if mso]>
                                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{referralLink}}" style="height:54px;v-text-anchor:middle;width:240px;" arcsize="26%" stroke="f" fillcolor="#1f74bf">
                                    <w:anchorlock/>
                                    <center>
                                <![endif]-->
                  <a href='{{referralLink}}' class='button'>Accept Invitation</a>
                  <!--[if mso]>
                                    </center>
                                </v:roundrect>
                                <![endif]-->
                </div>

                <div class='referral-info'>
                  <div class='referral-label'>Your Referral Code</div>
                  <div class='referral-code'>{{referralCode}}</div>
                </div>

                <div class='link-section'>
                  <span class='link-label'>Or use this direct link:</span>
                  <a
                    href='{{referralLink}}'
                    class='token-link'
                  >{{referralLink}}</a>
                </div>
              </div>

              <div class='footer'>
                <p>&copy; {{currentYear}} VendorEase. All rights reserved.</p>
                <p>123 Commerce Way, Retail District, New York, NY 10001</p>
                <p style='margin-top: 10px; font-size: 11px;'>If you weren't
                  expecting this invitation, you can safely ignore this email.</p>
              </div>
            </div>
          </td>
        </tr>
      </table>
      <!--[if mso]>
        </td>
        </tr>
        </table>
        <![endif]-->
    </div>
  </body>
</html>