<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Your Password - VendorEase</title>
    <!--[if mso]>
    <noscript>
    <xml>
    <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
    </xml>
    </noscript>
    <![endif]-->
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap');

      body,
      p,
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        margin: 0;
        padding: 0;
      }
      .ExternalClass {
        width: 100%;
      }
      .ExternalClass,
      .ExternalClass p,
      .ExternalClass span,
      .ExternalClass font,
      .ExternalClass td,
      .ExternalClass div {
        line-height: 100%;
      }
      #outlook a {
        padding: 0;
      }
      table {
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
        border-collapse: collapse !important;
      }
      img {
        -ms-interpolation-mode: bicubic;
        border: 0;
        height: auto;
        line-height: 100%;
        outline: none;
        text-decoration: none;
        display: block;
      }

      body {
        font-family:
          'Manrope',
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        background-color: #f9fafb;
        color: #12171a;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        width: 100% !important;
      }

      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #f9fafb;
        padding-bottom: 40px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        border: 1px solid #e1e4e8;
      }

      .header {
        padding: 30px 40px;
        text-align: left;
        border-bottom: 1px solid #f3f4f6;
      }
      .logo-container {
        display: inline-block;
        vertical-align: middle;
      }
      .logo {
        max-width: 32px;
        max-height: 32px;
        display: inline-block;
        vertical-align: middle;
      }
      .brand-name {
        display: inline-block;
        vertical-align: middle;
        font-size: 20px;
        font-weight: 800;
        color: #12171a;
        margin-left: 10px;
        letter-spacing: -0.02em;
      }

      .content {
        padding: 0 40px 40px;
        text-align: center;
      }

      .icon-box {
        background-color: rgba(220, 53, 69, 0.05);
        border-radius: 24px;
        padding: 40px;
        margin-bottom: 32px;
        display: inline-block;
        border: 1px solid rgba(220, 53, 69, 0.1);
      }

      h2 {
        font-size: 28px;
        font-weight: 800;
        color: #12171a;
        margin-bottom: 16px;
        letter-spacing: -0.03em;
        line-height: 1.2;
      }
      p {
        font-size: 16px;
        color: #4b5563;
        margin-bottom: 24px;
      }

      .btn-container {
        margin: 32px 0;
      }
      .button {
        background-color: #dc3545;
        background: linear-gradient(135deg, #dc3545, #e35d6a);
        color: #ffffff !important;
        text-decoration: none;
        padding: 18px 36px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 16px;
        display: inline-block;
        box-shadow: 0 10px 20px rgba(220, 53, 69, 0.15);
      }

      .security-notice {
        background-color: #fff8e6;
        border: 1px solid #ffeeba;
        border-radius: 12px;
        padding: 20px;
        margin-top: 32px;
        text-align: left;
      }
      .security-notice strong {
        color: #856404;
        display: block;
        margin-bottom: 4px;
      }
      .security-notice p {
        font-size: 14px;
        color: #856404;
        margin-bottom: 0;
      }

      .link-section {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid #f3f4f6;
        text-align: left;
      }
      .link-label {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #9ca3af;
        margin-bottom: 8px;
        display: block;
      }
      .token {
        background-color: #f9fafb;
        padding: 12px 16px;
        border-radius: 8px;
        font-family: 'SFMono-Regular', Consolas, monospace;
        font-size: 13px;
        color: #dc3545;
        word-break: break-all;
        border: 1px dashed #e1e4e8;
      }

      .footer {
        padding: 30px 40px;
        text-align: center;
        font-size: 13px;
        color: #9ca3af;
        border-top: 1px solid #f3f4f6;
      }

      @media screen and (max-width: 600px) {
        .container {
          width: 100% !important;
          border-radius: 0 !important;
          border: none !important;
        }
        .header,
        .content {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .icon-box {
          padding: 30px !important;
        }
        h2 {
          font-size: 24px !important;
        }
        .button {
          width: 100% !important;
          box-sizing: border-box;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <!--[if mso]>
        <table role="presentation" width="600" align="center" style="width:600px;">
        <tr>
        <td>
        <![endif]-->
      <table
        role='presentation'
        width='100%'
        cellspacing='0'
        cellpadding='0'
        style='max-width: 600px; margin: 0 auto;'
      >
        <tr>
          <td align='center' style='padding: 40px 0;'>
            <div class='container'>
              <div class='header'>
                <div class='logo-container'>
                  <img
                    src='https://res.cloudinary.com/djc5o8g94/image/upload/v1735699430/Sos/nsrtetcca9bfnfx7xx8x.png'
                    alt='Logo'
                    class='logo'
                  />
                  <span class='brand-name'>VendorEase</span>
                </div>
              </div>

              <div class='content' style='padding-top: 40px;'>
                <div class='icon-box'>
                  <svg
                    width='64'
                    height='64'
                    viewBox='0 0 24 24'
                    fill='none'
                    xmlns='http://www.w3.org/2000/svg'
                  >
                    <path
                      d='M12 15V17'
                      stroke='#dc3545'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    />
                    <rect
                      x='5'
                      y='10'
                      width='14'
                      height='11'
                      rx='2'
                      stroke='#dc3545'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    />
                    <path
                      d='M7 10V7C7 4.23858 9.23858 2 12 2C14.7614 2 17 4.23858 17 7V10'
                      stroke='#dc3545'
                      stroke-width='2'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                    />
                  </svg>
                </div>

                <h2>Reset your password</h2>
                <p>Hi <span style='font-weight: 600;'>{{name}}</span>,</p>
                <p>We received a request to reset the password for your
                  VendorEase account. No worries—it happens to the best of us!
                  Click the button below to secure your account with a new
                  password.</p>

                <div class='btn-container'>
                  <!--[if mso]>
                                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{resetUrl}}" style="height:54px;v-text-anchor:middle;width:240px;" arcsize="26%" stroke="f" fillcolor="#dc3545">
                                    <w:anchorlock/>
                                    <center>
                                <![endif]-->
                  <a href='{{resetUrl}}' class='button'>Reset My Password</a>
                  <!--[if mso]>
                                    </center>
                                </v:roundrect>
                                <![endif]-->
                </div>

                <div class='security-notice'>
                  <strong>⚠️ Security Notice</strong>
                  <p>This link is only valid for
                    <strong>1 hour</strong>. If you didn't request this change,
                    you can safely ignore this email and your password will
                    remain exactly as it is.</p>
                </div>

                <div class='link-section'>
                  <span class='link-label'>Or copy this link:</span>
                  <div class='token'>{{resetUrl}}</div>
                </div>
              </div>

              <div class='footer'>
                <p>&copy; {{currentYear}} VendorEase. All rights reserved.</p>
                <p>123 Commerce Way, Retail District, New York, NY 10001</p>
              </div>
            </div>
          </td>
        </tr>
      </table>
      <!--[if mso]>
        </td>
        </tr>
        </table>
        <![endif]-->
    </div>
  </body>
</html>